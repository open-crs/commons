FROM qbdi/qbdi:arm64_ubuntu

ENV USER="docker" \
    HOME="/home/docker"

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y \
    build-essential \
    cmake \
    sudo \
    bash \
    python3 \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN adduser --disabled-password --gecos '' $USER \
    && adduser $USER sudo \
    && echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers
USER $USER

WORKDIR $HOME

RUN qbdi-preload-template-AARCH64
RUN mkdir results

RUN rm qbdi_preload_template.c

CMD ["/bin/bash"]
